// StoreRx Prisma Schema
// AI Conversion Doctor for Shopify

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Shopify Session (required by shopify-app-session-storage-prisma)
// ============================================

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ============================================
// StoreRx Models
// ============================================

// Shop settings and configuration
model Shop {
  id     String  @id @default(cuid())
  domain String  @unique
  name   String?

  // Brand voice sample for AI generation
  brandVoice String?

  // Storefront password, so audits can scan password-protected stores
  // (FEATURES.md §15). A viewing password merchants share with testers — not
  // an admin credential — and never sent back to the browser.
  storefrontPassword String?

  // Unused: settings the UI once offered with nothing behind them — no
  // scheduler ran, no email was sent, no path was ever excluded. Kept rather
  // than dropped so an older deployment reading the table does not break.
  auditSchedule String  @default("weekly")
  emailSummary  Boolean @default(true)
  excludedPaths String?

  // Plan and billing (app/billing/plans.ts). Limits come from the plan table;
  // usage is counted from Audit and AiUsage rows since the period start.
  plan               String    @default("free") // free, starter, growth, pro
  subscriptionId     String? // Shopify AppSubscription GID of the paid plan
  subscriptionStatus String? // ACTIVE, CANCELLED, FROZEN… as Shopify reports it
  // Anchor of the rolling 30-day usage period; reset on every plan change.
  billingCycleStart  DateTime?
  // Legacy counters, superseded by AiUsage.units. Kept so older deployments
  // reading the table do not break mid-release.
  aiGenerationsUsed  Int       @default(0)
  aiGenerationsLimit Int       @default(5)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  audits           Audit[]
  suggestions      Suggestion[]
  aiUsage          AiUsage[]
  explanationCache ExplanationCache[]
  issues           Issue[]
}

// Audit run
model Audit {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Status. This table is the job queue: workers claim `pending` rows with
  // SELECT ... FOR UPDATE SKIP LOCKED, so no external broker is needed.
  status      String  @default("pending") // pending, running, completed, failed
  progress    Int     @default(0) // 0-100
  currentStep String?
  /**
   * Claim count, so a repeatedly-crashing audit stops instead of looping.
   */
  attempts    Int     @default(0)

  // What this scan covered. `scope` is the area the merchant asked for;
  // `evaluatedRules` lists rules that ran to completion, so only issues from
  // those rules can be opened or resolved by this scan.
  scope          String   @default("full")
  evaluatedRules String[] @default([])
  newCount       Int      @default(0)
  resolvedCount  Int      @default(0)

  // Overall scores (0-100)
  overallScore      Int?
  conversionScore   Int?
  uxScore           Int?
  performanceScore  Int?
  seoScore          Int?
  productPagesScore Int?

  // Counts
  totalIssues Int @default(0)
  highCount   Int @default(0)
  mediumCount Int @default(0)
  lowCount    Int @default(0)

  // Error info if failed
  error String?

  // Timestamps
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  findings   Finding[]
  pageScores PageScore[]

  // Supports the worker's claim query and the dashboard's latest-audit lookups.
  @@index([status, createdAt])
  @@index([shopId, status])
}

// Individual finding (issue detected by rule engine)
model Finding {
  id      String @id @default(cuid())
  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  // Rule identification
  ruleId   String // e.g., prod.reviews.fold
  pageType String // homepage, collection, product, cart, checkout, images, perf
  severity String // high, medium, low

  // Display
  title          String
  explanation    String? // AI: why it matters
  recommendation String? // AI: how to fix it manually

  // Storefront URL the rule ran against. Null for settings-level checks
  // (checkout, perf) that are not tied to one page.
  pageUrl String?

  // CDN URL of the affected image, for thumbnails on image findings.
  imageUrl String?

  // Stable identity of the problem across scans: rule + page/product/image.
  // Excludes titles and measured values, which change between scans.
  fingerprint String?
  isNew       Boolean   @default(false)
  firstSeenAt DateTime?

  // Evidence
  evidenceType  String? // selector, text, screenshot
  evidenceValue String?

  // How the merchant acts on this (app/remedies). StoreRx never writes to the
  // store, so this records where they go, not what it would change.
  remedy         String  @default("messaging") // admin, settings, theme, messaging
  adminArea      String? // product, collection, settings, theme
  adminRef       String? // GID, settings page slug, or theme template
  suggestionKind String? // copy StoreRx can draft: alt_text, seo_title, ...
  targetId       String? // Resource ID (product, image, etc.)
  targetTitle    String?

  // AI: ordered steps for implementing the recommendation.
  steps String[] @default([])

  // Status
  status String @default("open") // open, fixed, dismissed

  createdAt DateTime @default(now())
}

// Per-page scores from audit
model PageScore {
  id      String @id @default(cuid())
  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  // Page identification
  pageType   String // homepage, collection, product, cart
  pageUrl    String
  pageTitle  String?
  resourceId String? // Shopify resource ID if applicable

  // Scores
  croScore   Int?
  perfScore  Int?
  issueCount Int  @default(0)

  // Performance metrics
  lcp Float? // Largest Contentful Paint (seconds)
  cls Float? // Cumulative Layout Shift
  inp Float? // Interaction to Next Paint (ms)

  // Screenshot paths (stored for 30 days)
  mobileScreenshot  String?
  desktopScreenshot String?

  lastScannedAt DateTime @default(now())
}

// Copy StoreRx drafted for the merchant to review and paste in themselves.
// Never applied to the store: there is no apply or undo, by design. Drafted
// one item at a time, only when the merchant asks, so a large catalog cannot
// silently consume a plan's AI allowance.
model Suggestion {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // The issue this belongs to, and the exact resource inside it.
  issueId     String
  issue       Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  kind        String // alt_text, seo_title, seo_meta, product_description
  targetId    String // MediaImage or Product GID
  targetTitle String?
  imageUrl    String?

  // This table is also a queue: the worker claims `pending` rows the same way
  // it claims audits.
  status   String @default("pending") // pending, ready, failed
  attempts Int    @default(0)

  /// The value in the store when the draft was made, so the UI can show the
  /// merchant what they are replacing.
  current   String?
  suggested String?
  error     String?

  createdAt DateTime  @default(now())
  readyAt   DateTime?

  // One live draft per resource per kind; re-drafting replaces it.
  @@unique([issueId, targetId, kind])
  @@index([status, createdAt])
  @@index([shopId, createdAt])
}

// AI usage tracking for cost management
model AiUsage {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Task info
  task  String // explain, description, alt_text, etc.
  model String // gpt-4.1, gpt-4.1-mini

  // Token usage
  promptTokens     Int
  completionTokens Int
  totalTokens      Int

  // Cost estimate (in cents)
  estimatedCost Float?

  // Plan allowance consumed by this call, e.g. explanations generated.
  units Int @default(1)

  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}

// Liveness signal from each running worker, so the dashboard can tell a scan
// that is waiting for a worker apart from one that is in progress.
model WorkerHeartbeat {
  id         String   @id // hostname:pid
  lastSeenAt DateTime
}

// AI explanation per shop and rule, reused across scans so an unchanged issue
// is never paid for twice. `contextHash` covers the prompt version and brand
// voice; when either changes the entry is regenerated.
model ExplanationCache {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ruleId         String
  contextHash    String
  explanation    String
  recommendation String
  steps          String[] @default([])
  updatedAt      DateTime @updatedAt

  @@unique([shopId, ruleId])
}

// The store's current issues, across every area. Findings are per-scan
// snapshots; an Issue is the living record a scan opens, keeps or resolves.
// Partial scans only touch issues from the rules they ran.
model Issue {
  id          String @id @default(cuid())
  shopId      String
  shop        Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fingerprint String

  ruleId         String
  pageType       String
  severity       String
  title          String
  explanation    String?
  recommendation String?
  evidenceType   String?
  evidenceValue  String?
  pageUrl        String?
  targetId       String?
  targetTitle    String?
  imageUrl       String?

  // Where and how the merchant acts on this (app/remedies).
  remedy         String  @default("messaging") // admin, settings, theme, messaging
  adminArea      String? // product, collection, settings, theme
  adminRef       String? // GID, settings page slug, or theme template
  suggestionKind String? // copy StoreRx can draft: alt_text, seo_title, ...

  // AI: ordered steps for implementing the recommendation.
  steps String[] @default([])

  // open → awaiting_verification (merchant says they fixed it) → resolved
  // (a scan confirmed it). A scan that still finds it sends it back to open
  // and stamps verificationFailedAt, so the UI can say the check did not pass.
  status               String    @default("open")
  markedResolvedAt     DateTime?
  verificationFailedAt DateTime?
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  lastSeenAuditId String
  // The scan that opened (or reopened) this issue, and whether it counted as
  // new there. "New" is shown only until a later scan sees the issue again.
  openedAuditId   String
  openedAsNew     Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedAuditId String?

  suggestions Suggestion[]

  @@unique([shopId, fingerprint])
  @@index([shopId, status])
}
